.card { margin: 24rpx 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f2f2f2; font-size: 28rpx; }
.row span { color: #909399; }
.row input { text-align: right; }
button { background: #07c160; color: #fff; border-radius: 12rpx; margin-top: 12rpx; }
button::after { border: none; }
.md { font-size: 24rpx; color: #606266; white-space: pre-wrap; line-height: 1.6; }
