<view class="card">
  <view class="title">城乡农品溯源 · 农户端</view>
  <view class="sub">轻量录入农事，自动核算碳足迹</view>
</view>

<block wx:if="{{!logged}}">
  <view class="card">
    <button class="btn-primary" bindtap="wechatLogin">微信一键登录</button>
    <view class="sub" style="text-align:center;margin-top:12rpx">登录后即可录入农事、查看碳报告</view>
  </view>
</block>

<block wx:else>
  <view class="card">
    <view class="row"><span>农户</span><b>{{user.realName || user.username}}</b></view>
    <view class="row"><span>角色</span><b>{{user.role}}</b></view>
    <view class="row"><span>合作社</span><b>{{user.coopId || '-'}}</b></view>
  </view>

  <view class="card">
    <button class="btn-primary" bindtap="goFarming">＋ 录入农事记录</button>
    <button style="margin-top:16rpx" bindtap="goReport">查看碳足迹报告 / 补贴材料</button>
  </view>
</block>
